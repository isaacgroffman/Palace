# copy to .env (or set in Connect Cloud / HF Space secrets). Never commit .env.
password=                 # app login
HF_TOKEN=                 # Hugging Face token with READ on the CoastalBaseball datasets (WRITE if you run --upload)
TM_CLIENT_ID=             # TrackMan Data API (Edgertronic video tokens)
TM_SECRET=
TM_USERNAME=              # TruMedia
TM_SITENAME=
TM_MASTER_TOKEN=
# Supabase (R/palace_supabase.R): bullpen pitches + pitchprofiler.* scored NCAA tables
SB_DB_HOST=aws-0-us-east-1.pooler.supabase.com   # Project Settings > Database > Connection string (pooler host)
SB_DB_USER=                                       # bullpen_reader.<projectref> is enough (read-only)
SB_DB_PASS=

# ---- Palace data mode ----
PALACE_DATA_MODE=serve            # serve = precomputed pools (fast) | build = rebuild from raw at boot (slow, legacy)
PALACE_SERVING_REPO=CoastalBaseball/PalaceServing   # HF dataset repo written by scripts/build_serving_data.R
PALACE_SERVING_DIR=               # optional: local folder with pools/ artifacts/ files/ (skips HF)
PALACE_PREWARM=FALSE              # TRUE = force the lazy P5/SBC pools at boot instead of on first click
RETICULATE_PYTHON=/usr/bin/python3            # a python with lightgbm/polars/pandas/pyarrow, e.g. ~/.venvs/pitchprofiler/bin/python
