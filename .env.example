# copy to .env (or set in Connect Cloud's Variables panel). Never commit .env.
password=                 # break-glass login: username `admin` + this password (remove once real users exist)
PALACE_SESSION_SECRET=    # any long random string; signs the 30-day login cookies (changing it signs everyone out)
TM_CLIENT_ID=             # TrackMan Data API (Edgertronic video tokens; the Upload panel's fetches)
TM_CLIENT_SECRET=         # (TM_SECRET is accepted as an alias)
TM_USERNAME=              # TruMedia (leaderboards; fallback when a pitcher is not in Supabase)
TM_SITENAME=
TM_MASTER_TOKEN=
# Supabase (R/palace_supabase.R): bullpen pitches + pitchprofiler.* scored 2026 NCAA tables
SB_DB_HOST=aws-0-us-east-1.pooler.supabase.com   # Project Settings > Database > Connection string (pooler host)
SB_DB_USER=                                       # a read-only role is enough, e.g. bullpen_reader.<projectref>
SB_DB_PASS=
SB_DB_PORT=5432                                   # session pooler (6543 = transaction pooler, drops wide pulls)
SUPABASE_URL=https://ryqzkosdbksawrcrdqrc.supabase.co   # Storage: precomputed reference pools (bucket palace-serving)
SUPABASE_SECRET_KEY=                              # a secret API key (Project Settings > API); the bucket is private

PALACE_PREWARM=FALSE      # TRUE = pull the P5/SBC reference pools at boot instead of on first use
RETICULATE_PYTHON=        # a python with lightgbm/polars/pandas/pyarrow (Connect Cloud sets this itself)

# Upload panel (R/palace_upload.R, admins only)
PALACE_UPLOAD_DIR=        # working directory for fetch/commit jobs (default /data/palace_uploads on Connect, ~/.palace_uploads locally)
PALACE_PYTHON=            # interpreter with lightgbm/polars/pandas/pyarrow for scoring game uploads (falls back to RETICULATE_PYTHON)
# Bullpen / batting-practice uploads write through SUPABASE_URL + SUPABASE_SECRET_KEY (REST + Storage).
# Game uploads write pitchprofiler.* through SB_DB_* and need the postgres.<projectref> role, not bullpen_reader.
